{
  "AzureStorageBlobs": {
    "Endpoint": "{{AZURE_STORAGE_BLOB_ENDPOINT}}",
    "ContainerName": "{{AZURE_STORAGE_BLOB_CONTAINER_NAME}}"
  },
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{APP_TENANT_ID}}",
        "ClientId": "{{APP_CLIENT_ID}}",
        "ClientSecret": "{{APP_CLIENT_SECRET}}",
        "Scopes": [
          "https://api.botframework.com/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],
  "DirectLine": {
    "Endpoint": "https://directline.botframework.com/v3/directline/tokens/generate",
    "SecretKey": "{{DIRECTLINE_SECRET_KEY}}"
  },
  "MicrosoftEntra": {
    "ClientId": "{{APP_CLIENT_ID}}",
    "ClientSecret": "{{APP_CLIENT_SECRET}}",
    "Instance": "https://login.microsoftonline.com",
    "TenantId": "{{APP_TENANT_ID}}"
  },
  "MicrosoftGraph": {
    "ClientId": "{{APP_CLIENT_ID}}",
    "ClientSecret": "{{APP_CLIENT_SECRET}}",
    "TenantId": "{{APP_TENANT_ID}}"
  },
  "TokenValidation": {
    "Audiences": [
      "{{APP_CLIENT_ID}}"
    ],
    "TenantId": "{{APP_TENANT_ID}}"
  }
}
