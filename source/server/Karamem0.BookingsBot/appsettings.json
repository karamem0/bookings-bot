{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      },
      "EnableDependencyTrackingTelemetryModule": false,
      "EnablePerformanceCounterCollectionModule": false
    }
  },
  "AzureStorageBlobs": {
    "Endpoint": "{{AZURE_STORAGE_BLOB_ENDPOINT}}",
    "ContainerName": "{{AZURE_STORAGE_BLOB_CONTAINER_NAME}}",
    "ClientId": "{{AZURE_STORAGE_BLOB_CLIENT_ID}}"
  },
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{MSAL_TENANT_ID}}",
        "ClientId": "{{MSAL_CLIENT_APP_ID}}",
        "ClientSecret": "{{MSAL_CLIENT_APP_SECRET}}",
        "Scopes": [
          "https://api.botframework.com/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],
  "DirectLine": {
    "Endpoint": "https://directline.botframework.com/v3/directline/tokens/generate",
    "SecretKey": "{{DIRECTLINE_SECRET}}"
  },
  "MicrosoftEntra": {
    "ClientId": "{{MSAL_CLIENT_APP_ID}}",
    "ClientSecret": "{{MSAL_CLIENT_APP_SECRET}}",
    "Instance": "https://login.microsoftonline.com",
    "TenantId": "{{MSAL_TENANT_ID}}"
  },
  "MicrosoftGraph": {
    "ClientId": "{{MSAL_CLIENT_APP_ID}}",
    "ClientSecret": "{{MSAL_CLIENT_APP_SECRET}}",
    "TenantId": "{{MSAL_TENANT_ID}}"
  },
  "TokenValidation": {
    "Audiences": [
      "{{MSAL_CLIENT_APP_ID}}"
    ],
    "TenantId": "{{MSAL_TENANT_ID}}"
  }
}
