{
  "name": "@karamem0/bookings-bot",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "stylelint": "stylelint src/**/*.{css,scss,jsx,tsx}",
    "stylelint:fix": "stylelint src/**/*.{css,scss,jsx,tsx} --fix",
    "formatjs:extract": "formatjs extract src/**/messages.ts --out-file src/translations/en.json --id-interpolation-pattern [sha512:contenthash:base64:6] --format simple",
    "formatjs:compile": "npm run formatjs:compile-en && npm run formatjs:compile-ja",
    "formatjs:compile-en": "formatjs compile src/translations/en.json --out-file src/translations/compiled/en.json --ast --format simple",
    "formatjs:compile-ja": "formatjs compile src/translations/ja.json --out-file src/translations/compiled/ja.json --ast --format simple"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.26.0",
    "@azure/msal-react": "^5.7.3",
    "@emotion/react": "^11.14.0",
    "@fluentui/react-components": "^9.74.11",
    "@microsoft/applicationinsights-common": "3.4.5",
    "@microsoft/applicationinsights-react-js": "^19.4.2",
    "@microsoft/applicationinsights-web": "3.4.5",
    "axios": "^1.20.0",
    "botframework-webchat": "^4.19.2",
    "botframework-webchat-fluent-theme": "^4.19.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-icons": "^5.7.0",
    "react-intl": "^10.2.2",
    "react-router": "8.5.0",
    "react-use": "^17.6.1",
    "ress": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@formatjs/cli": "^6.16.35",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/plugin-emotion": "^19.0.0",
    "@swc/plugin-formatjs": "^14.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-hooks": "^0.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "postcss-styled-syntax": "^0.7.4",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.2",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "katex": "^0.19.0",
    "react-redux": "^9.2.0",
    "sanitize-html": "^2.18.0",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2"
  }
}
